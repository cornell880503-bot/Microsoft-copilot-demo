# Copy to .env and fill in your key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the executor model (default: gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# Optional: override the fast router model chain
# GEMINI_ROUTER_MODEL=gemini-2.5-flash
# GEMINI_ROUTER_FALLBACK_MODEL=gemini-3-flash-preview

# Optional: override the port (default: 8765)
# SIDECAR_PORT=8765

# SMTP settings for real email sending
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your_16_char_google_app_password
# SMTP_FROM=yourname@gmail.com

# Other providers:
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
